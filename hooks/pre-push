#!/bin/bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) 2026 dravr.ai
# ABOUTME: Pre-push hook — refuses AI-attributed commits, then runs clippy or checks the marker
# ABOUTME: Works for all dravr-* repos whether they have pre-push-validate.sh or not

set -e

# ---- No AI attribution in anything this push publishes ----
# commit-msg refuses an AI identity or attribution line when a commit is made,
# but a commit made with hooks bypassed, before the hooks existed, or by a
# command that runs no commit hook (cherry-pick, revert and rebase keep the
# original author) reaches this point unjudged. So every commit this push would
# publish that no remote has yet is judged again, by the same rules. History
# already on a remote is never re-judged: this push cannot change it, so it must
# not block it. This runs before anything else, the docs-only exit included.
HOOK_DIR=$(dirname "${BASH_SOURCE[0]}")
# shellcheck source=hooks/ai-attribution.sh
if ! . "$HOOK_DIR/ai-attribution.sh"; then
    echo "BLOCKED: $HOOK_DIR/ai-attribution.sh is missing, so AI attribution cannot be checked."
    echo "  Point core.hooksPath at the .build/hooks directory, and run:"
    echo "    git submodule update --init --recursive .build"
    exit 1
fi

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# A terminal on stdin means the hook was run by hand, with no refs to read.
PUSH_TIPS=()
REMOTE_HAS=()
if [ ! -t 0 ]; then
    while read -r _ LOCAL_SHA _ REMOTE_SHA; do
        # An all-zero local sha is a deletion: it publishes no commit.
        case "$LOCAL_SHA" in *[!0]*) ;; *) continue ;; esac
        # Tags of trees or blobs carry no commit to judge.
        TIP=$(git rev-parse -q --verify "$LOCAL_SHA^{commit}" 2>/dev/null) || continue
        PUSH_TIPS+=("$TIP")
        # What the remote's ref points at is on that remote even when no
        # remote-tracking ref has fetched it yet.
        case "$REMOTE_SHA" in
            *[!0]*) git cat-file -e "$REMOTE_SHA^{commit}" 2>/dev/null && REMOTE_HAS+=("$REMOTE_SHA") ;;
        esac
    done
fi

if [ "${#PUSH_TIPS[@]}" -gt 0 ]; then
    # Everything after --not is excluded: commits any remote-tracking ref reaches,
    # and commits the remote's own refs already reach. --no-show-signature keeps a
    # log.showSignature config from splicing gpg lines into the parsed output.
    if ! NEW_IDENTS=$(git log --no-show-signature --format='%H%x1f%an%x1f%ae%x1f%cn%x1f%ce' \
            "${PUSH_TIPS[@]}" --not --remotes "${REMOTE_HAS[@]}"); then
        echo "BLOCKED: could not list the commits this push publishes, so AI attribution is unchecked."
        exit 1
    fi

    NEW_COUNT=0
    IDENT_HITS=""
    while IFS=$'\037' read -r SHA AUTHOR_NAME AUTHOR_EMAIL COMMITTER_NAME COMMITTER_EMAIL; do
        [ -n "$SHA" ] || continue
        NEW_COUNT=$((NEW_COUNT + 1))
        if ai_identity_is_ai "$AUTHOR_NAME" "$AUTHOR_EMAIL"; then
            IDENT_HITS="$IDENT_HITS  ${SHA:0:12}  author     $AUTHOR_NAME <$AUTHOR_EMAIL> ($AI_IDENTITY_WHY)"$'\n'
        fi
        if ai_identity_is_ai "$COMMITTER_NAME" "$COMMITTER_EMAIL"; then
            IDENT_HITS="$IDENT_HITS  ${SHA:0:12}  committer  $COMMITTER_NAME <$COMMITTER_EMAIL> ($AI_IDENTITY_WHY)"$'\n'
        fi
    done <<< "$NEW_IDENTS"

    # One line per message line, "<sha> TAB <line number> TAB <text>", so a single
    # grep judges every message at once and can say which line matched. The sha
    # and number fields are hex and digits, which no pattern can match.
    MESSAGE_HITS=$(git log --no-show-signature --format='%x1e%H%x1f%B' \
            "${PUSH_TIPS[@]}" --not --remotes "${REMOTE_HAS[@]}" |
        awk 'BEGIN { RS = "\036"; FS = "\037" }
             NF > 1 {
                 msg = $2
                 for (f = 3; f <= NF; f++) msg = msg FS $f
                 n = split(msg, lines, "\n")
                 for (i = 1; i <= n; i++) printf "%s\t%d\t%s\n", $1, i, lines[i]
             }' |
        grep -iE "$AI_MESSAGE_RE" |
        awk -F'\t' '{ printf "  %s  message    line %s: %s\n", substr($1, 1, 12), $2, $3 }' || true)

    if [ -n "$IDENT_HITS" ] || [ -n "$MESSAGE_HITS" ]; then
        # The oldest offender in topological order is the one every other
        # offender descends from or sits beside, so rebasing from its parent
        # reaches them all.
        OFFENDING=" $(printf '%s%s\n' "$IDENT_HITS" "$MESSAGE_HITS" | awk 'NF { print $1 }' | tr '\n' ' ')"
        OLDEST=""
        for SHA in $(git rev-list --topo-order --reverse "${PUSH_TIPS[@]}" --not --remotes "${REMOTE_HAS[@]}"); do
            case "$OFFENDING" in *" ${SHA:0:12} "*) OLDEST=$SHA; break ;; esac
        done
        if [ -n "$OLDEST" ] && git rev-parse -q --verify "$OLDEST^" >/dev/null 2>&1; then
            REBASE_BASE="${OLDEST:0:12}^"
        else
            REBASE_BASE="--root"
        fi

        echo ""
        echo "BLOCKED: this push publishes commits that credit an AI tool."
        echo ""
        printf '%s' "$IDENT_HITS"
        if [ -n "$MESSAGE_HITS" ]; then printf '%s\n' "$MESSAGE_HITS"; fi
        echo ""
        echo "Only commits no remote has yet are checked; history already pushed never blocks."
        echo ""
        ai_identity_fix_hint
        echo ""
        echo "   Then rewrite each listed commit with that identity, deleting its attribution lines:"
        echo "     the last commit only:  git commit --amend --reset-author"
        echo "     several commits:       git rebase -i $REBASE_BASE"
        echo "                            (mark each listed commit 'edit', then at each stop run"
        echo "                            git commit --amend --reset-author && git rebase --continue;"
        echo "                            add --rebase-merges if the branch contains merges)"
        echo ""
        exit 1
    fi
    if [ "$NEW_COUNT" -gt 0 ]; then
        echo "Pre-push: $NEW_COUNT new commit(s) carry no AI identity or attribution"
    fi
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --git-dir)"
MARKER_FILE="$GIT_DIR/validation-passed"
VALIDATION_TTL_MINUTES=15
VALIDATE_SCRIPT="$PROJECT_ROOT/scripts/ci/pre-push-validate.sh"

# What this push actually carries, relative to what the remote already has.
# Read twice below: by the inert-push exit here, and by the workspace branch
# further down that scopes clippy to the crates whose files changed.
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if git rev-parse --verify "origin/$CURRENT_BRANCH" &>/dev/null; then
    BASE_REF="origin/$CURRENT_BRANCH"
elif git rev-parse --verify "origin/main" &>/dev/null; then
    BASE_REF="origin/main"
else
    BASE_REF="HEAD~1"
fi
CHANGED_FILES=$(git diff --name-only "$BASE_REF" HEAD 2>/dev/null || echo "")

# Paths no validation tier reads: prose, and the agent/editor config that steers
# Claude Code rather than the build. This is an allowlist on purpose — a denylist
# of "things that matter" silently stops covering whatever gets added next.
# The .build gitlink is here because bumping the shared build config changes the
# rules a future push is measured against, never the code in this one.
INERT_RE='\.md$|^\.claude/|^\.build$|^\.gitignore$|^LICENSE'

# An empty list means the diff could not be computed, not that nothing changed —
# fall through to the full gate rather than skipping it on a failure to look.
if [ -n "$CHANGED_FILES" ] &&
   [ -z "$(printf '%s\n' "$CHANGED_FILES" | grep -vE "$INERT_RE" || true)" ]; then
    echo "Pre-push: docs and agent config only — skipping local validation (CI still runs in full)"
    echo ""
    echo "REMINDER: Monitor CI after pushing. The Agent does NOT consider work"
    echo "complete until CI on the pushed commit is green. See AGENTS.md →"
    echo "'After Pushing — MANDATORY CI MONITORING'."
    exit 0
fi

# If the project has pre-push-validate.sh, enforce the marker system.
# Otherwise, run an inline clippy gate scoped to changed crates.
if [ -f "$VALIDATE_SCRIPT" ]; then
    # ---- Marker-based validation (dravr-platform, and every satellite through ----
    # ---- validation/satellite-pre-push-validate.sh) ----
    if [ ! -f "$MARKER_FILE" ]; then
        echo ""
        echo "BLOCKED: No validation marker found."
        echo ""
        echo "Run before pushing:"
        echo "  ./scripts/ci/pre-push-validate.sh"
        echo ""
        exit 1
    fi

    read -r MARKER_TIME MARKER_COMMIT < "$MARKER_FILE"
    CURRENT_COMMIT=$(git rev-parse HEAD)
    CURRENT_TIME=$(date +%s)

    if [ "$MARKER_COMMIT" != "$CURRENT_COMMIT" ]; then
        echo ""
        echo "BLOCKED: Validation marker is for a different commit."
        echo "  Marker:  ${MARKER_COMMIT:0:12}"
        echo "  Current: ${CURRENT_COMMIT:0:12}"
        echo ""
        echo "Re-run: ./scripts/ci/pre-push-validate.sh"
        echo ""
        exit 1
    fi

    ELAPSED=$(( CURRENT_TIME - MARKER_TIME ))
    TTL_SECONDS=$(( VALIDATION_TTL_MINUTES * 60 ))

    if [ "$ELAPSED" -gt "$TTL_SECONDS" ]; then
        ELAPSED_MIN=$(( ELAPSED / 60 ))
        echo ""
        echo "BLOCKED: Validation marker expired (${ELAPSED_MIN}m old, max ${VALIDATION_TTL_MINUTES}m)."
        echo ""
        echo "Re-run: ./scripts/ci/pre-push-validate.sh"
        echo ""
        exit 1
    fi

    echo "Validation marker OK (${ELAPSED}s old, commit ${CURRENT_COMMIT:0:12})"
    echo ""
    echo "REMINDER: Monitor CI after pushing. The Agent does NOT consider work"
    echo "complete until CI on the pushed commit is green. See AGENTS.md →"
    echo "'After Pushing — MANDATORY CI MONITORING'."
    exit 0
fi

# ---- Inline validation (fallback for repos without pre-push-validate.sh) ----
[ ! -f "$PROJECT_ROOT/Cargo.toml" ] && exit 0

cd "$PROJECT_ROOT"

# Detect whether this is a Cargo workspace with crates/ layout
IS_WORKSPACE=false
if grep -q "^\[workspace\]" "$PROJECT_ROOT/Cargo.toml" 2>/dev/null && [ -d "$PROJECT_ROOT/crates" ]; then
    IS_WORKSPACE=true
fi

# Anything that can change what clippy or rustfmt report. A push that reaches
# here carries something non-inert — frontend or scripts, say — but if none of
# it is Rust, the Rust gate below has nothing to find. CHANGED_FILES and
# BASE_REF are computed once at the top of this hook.
RUST_CHANGE_RE='\.rs$|(^|/)Cargo\.(toml|lock)$|(^|/)(clippy|rustfmt|rust-toolchain)\.toml$|(^|/)rust-toolchain$'

# ---- Shared architectural validation (compile-free, ~0.5s) ----
# validate.sh's rules are pure text scans — the .expect()/unwrap bans, placeholder
# and stub-signature detection, ignored tests, CI continue-on-error, the register
# gates. Skipping them locally buys nothing and costs a full red CI round-trip when
# one lands, which is exactly how an .expect() violation reached CI from
# dravr-sciotte. Repos owning a scripts/ci/pre-push-validate.sh never reach this
# line — the marker branch above exits on every path — and they run this same tier
# themselves, so nothing double-runs.
#
# This sits BEFORE the Rust-only exit below on purpose: validate.sh reads more than
# Rust (.github/workflows/, JS/TS test files, the register config), so a
# workflow-only push still needs it. The regex over-matches by design; a needless
# half-second beats a missed violation.
ARCH_VALIDATE="$PROJECT_ROOT/.build/validation/validate.sh"
VALIDATION_CHANGE_RE="$RUST_CHANGE_RE"'|^\.github/workflows/|(^|/)(validation-patterns\.local|ignored-tests-allowlist|registre)\.toml$|(^|/)feature-phases\.ya?ml$|\.(test|spec)\.[jt]sx?$'

if [ ! -f "$ARCH_VALIDATE" ]; then
    echo "Pre-push: .build/validation/validate.sh missing — run: git submodule update --init --recursive"
elif [ -z "$CHANGED_FILES" ] || printf '%s\n' "$CHANGED_FILES" | grep -qE "$VALIDATION_CHANGE_RE"; then
    # An empty CHANGED_FILES means the diff could not be computed, not that nothing
    # changed, so run the gate rather than skip it — same stance as the checks above.
    echo "Pre-push: architectural validation..."
    # stdin is redirected because pre-push receives the ref list on it, and
    # validate.sh documents that an rg with an empty path argument will otherwise
    # read stdin and block. Output is held and replayed only on failure, matching
    # the terse style of the fmt gate below.
    if ! ARCH_OUTPUT=$(bash "$ARCH_VALIDATE" < /dev/null 2>&1); then
        printf '%s\n' "$ARCH_OUTPUT"
        echo ""
        echo "BLOCKED: Architectural validation failed. Fix the issues above before pushing."
        exit 1
    fi
fi

if [ -n "$CHANGED_FILES" ] && ! printf '%s\n' "$CHANGED_FILES" | grep -qE "$RUST_CHANGE_RE"; then
    echo "Pre-push: no Rust in this push — skipping fmt and clippy (CI runs both)"
    echo ""
    echo "REMINDER: Monitor CI after pushing. The Agent does NOT consider work"
    echo "complete until CI on the pushed commit is green. See AGENTS.md →"
    echo "'After Pushing — MANDATORY CI MONITORING'."
    exit 0
fi

echo "Pre-push: cargo fmt --check..."
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo "BLOCKED: Code not formatted. Run: cargo fmt --all"
    exit 1
fi

# Clippy below denies warnings through Cargo's build.warnings, not
# `-- -D warnings`: a warning then stays a warning, the crate still builds, and
# the run fails once at the end with every warning printed. Cargo before 1.97
# ignores the key without a word and would pass every warning, so refuse to
# run on one (a Homebrew cargo ahead of rustup on PATH is the usual way).
CARGO_VERSION=$(cargo --version | awk '{print $2}')
CARGO_MAJOR=${CARGO_VERSION%%.*}
CARGO_MINOR=${CARGO_VERSION#*.}
CARGO_MINOR=${CARGO_MINOR%%.*}
if [ "$CARGO_MAJOR" -lt 1 ] || { [ "$CARGO_MAJOR" -eq 1 ] && [ "$CARGO_MINOR" -lt 97 ]; }; then
    echo "BLOCKED: cargo $CARGO_VERSION predates build.warnings (cargo 1.97) and would"
    echo "  ignore it. Put rustup's cargo first on PATH so rust-toolchain.toml"
    echo "  selects the pinned toolchain."
    exit 1
fi
export CARGO_BUILD_WARNINGS=deny

if [ "$IS_WORKSPACE" = true ]; then
    # Workspace: scope clippy to crates whose files changed (fast local gate).
    # CI runs full workspace clippy — this is intentionally narrower.

    # Read `name` from the [package] section only. A root Cargo.toml also carries
    # [workspace] with a members list, and a bare `grep name` picks those up instead.
    pkg_name_of() {
        awk '/^\[package\]/{f=1;next} /^\[/{f=0} f' "$1" 2>/dev/null \
            | grep -m1 '^name[[:space:]]*=' \
            | sed -E 's/name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/'
    }

    # Collect changed package NAMES (bash 3.2 compatible — no associative arrays).
    # Names rather than directories, because a package need not be named after its
    # folder — dravr-embacle ships a package called `embacle` — and `cargo -p` wants
    # the name.
    CHANGED_PKGS=""
    add_pkg() {
        [ -z "$1" ] && return 0
        case " $CHANGED_PKGS " in
            *" $1 "*) ;;
            *) CHANGED_PKGS="$CHANGED_PKGS $1" ;;
        esac
    }

    while IFS= read -r file; do
        [ -z "$file" ] && continue
        case "$file" in
            crates/*)
                crate_dir="${file#crates/}"
                crate_dir="${crate_dir%%/*}"
                if [ -n "$crate_dir" ] && [ -d "$PROJECT_ROOT/crates/$crate_dir" ]; then
                    p=$(pkg_name_of "$PROJECT_ROOT/crates/$crate_dir/Cargo.toml")
                    [ -z "$p" ] && p="$crate_dir"
                    add_pkg "$p"
                fi
                ;;
            src/*|build.rs)
                # The workspace root is often a package in its own right, with sources
                # in src/ rather than crates/. Nine dravr repos are shaped this way, so
                # scanning only crates/ reported "no crate changes detected" and skipped
                # clippy entirely for real code changes — a gate that reads as passing.
                add_pkg "$(pkg_name_of "$PROJECT_ROOT/Cargo.toml")"
                ;;
        esac
    done <<< "$CHANGED_FILES"

    CHANGED_PKGS="${CHANGED_PKGS# }"

    if [ -z "$CHANGED_PKGS" ]; then
        echo "Pre-push: no package changes detected, skipping clippy (CI will run full workspace clippy)"
    else
        for pkg in $CHANGED_PKGS; do
            echo "Pre-push: clippy -p $pkg --all-targets --all-features"
            if ! cargo clippy -p "$pkg" --all-targets --all-features; then
                echo ""
                echo "BLOCKED: Clippy failed for $pkg. Fix warnings before pushing."
                exit 1
            fi
        done
    fi
else
    # Single-crate repo — full clippy is the per-crate case.
    echo "Pre-push: cargo clippy --all-targets --all-features..."
    if ! cargo clippy --all-targets --all-features 2>&1; then
        echo ""
        echo "BLOCKED: Clippy failed. Fix all warnings before pushing."
        exit 1
    fi
fi

echo "Pre-push: OK"
echo ""
echo "REMINDER: Monitor CI after pushing. The Agent does NOT consider work"
echo "complete until CI on the pushed commit is green. See AGENTS.md →"
echo "'After Pushing — MANDATORY CI MONITORING'."
