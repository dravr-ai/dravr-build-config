#!/bin/bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) 2026 dravr.ai
# ABOUTME: Shared pre-commit hook for all dravr-* projects
# ABOUTME: Checks SPDX headers, formatting, and runs lint on staged files

set -e

# Block Terraform state/plan files. They embed every resolved secret in
# PLAINTEXT, and because tfplan is a compressed archive, content-based secret
# scanners (GitHub, gitleaks, trufflehog) cannot see inside it. Filename is the
# only reliable signal. State belongs in a remote encrypted backend, never git.
STAGED_TF=$(git diff --cached --name-only --diff-filter=ACM | grep -E -e '(^|/)tfplan([-.]|$)' -e '\.tfstate($|\.)' -e '\.tfplan$' || true)
if [ -n "$STAGED_TF" ]; then
    echo "❌ Refusing to commit Terraform state/plan files (they embed plaintext secrets):"
    echo "$STAGED_TF" | sed 's/^/   /'
    echo "   Add these to .gitignore and use a remote encrypted backend (GCS/S3)."
    exit 1
fi

# Check SPDX headers on staged Rust files
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    for f in $STAGED_RS; do
        if ! head -5 "$f" | grep -q "SPDX-License-Identifier:"; then
            echo "❌ Missing SPDX header: $f"
            echo "   Add: // SPDX-License-Identifier: MIT OR Apache-2.0"
            exit 1
        fi
    done
fi

# Check frontend lint if frontend files staged
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v 'node_modules' || true)
if [ -n "$STAGED_TS" ]; then
    if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
        echo "🔍 Running frontend lint checks..."
        # Capture rather than pipe. `bun run lint | tail` makes $? the tail's,
        # which is always 0, and the success line below used to print with no
        # test at all — so a real lint failure, and a missing eslint exiting
        # 127, both reported a green check. Run in a subshell so a failed cd
        # cannot leave the hook above the repo root.
        lint_output=$(cd frontend && bun run lint 2>&1)
        lint_status=$?
        if [ "$lint_status" -eq 127 ] || printf '%s' "$lint_output" | grep -q 'command not found'; then
            # The toolchain is absent (a fresh worktree with no bun install).
            # Say so plainly instead of claiming a pass; CI runs the real lint.
            printf '%s\n' "$lint_output" | tail -5
            echo "⚠️  Frontend lint SKIPPED — toolchain missing. Run: (cd frontend && bun install)"
        elif [ "$lint_status" -ne 0 ]; then
            printf '%s\n' "$lint_output" | tail -20
            echo "❌ Frontend lint failed (exit $lint_status)"
            exit 1
        else
            echo "✅ Frontend lint checks passed"
        fi
    fi
fi

echo "✅ All pre-commit checks passed"
